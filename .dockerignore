# =============================================================================
# Docker Ignore File for Sub2API
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!deploy/DOCKER.md
docs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/

# Node modules (will be installed in container)
frontend/node_modules/
frontend/.pnpm-store/
frontend/dist/
frontend/pnpm-workspace.yaml
node_modules/

# Go build cache (will be built in container)
backend/vendor/
backend/bin/
backend/logs/
backend/data/
backend/*.exe
backend/*.exe~
backend/sub2api-local*
backend/sub2api-linux-amd64*
backend/sub2api-stream-test*
backend/sub2api-test-old*
backend/sub2api-old-test*
backend/*.bak*
backend/*.combined.log

# Test files
*_test.go
**/*.test.js
coverage/
.nyc_output/

# Environment files
.env
.env.*
!.env.example

# Local config
config.yaml
config.local.yaml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Deploy files (not needed in image)
deploy/install.sh
deploy/sub2api.service
deploy/sub2api-sudoers
deploy/data/
deploy/postgres_data/
deploy/redis_data/

# GoReleaser
.goreleaser.yaml

# GitHub
.github/

# Claude files
.claude/
issues/
CLAUDE.md

# Local Codex / temporary artifacts
.codex-qwen2API/
